# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
DB_NAME=octos_db
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# App
DJANGO_SETTINGS_MODULE=config.settings


# Redis, for Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Paystack
# sk_test_ and pk_test_ while proving the flow; sk_live_ and pk_live_
# only when the next person through the storefront should be spending
# real money.
#
# The webhook also has to be registered in Paystack's dashboard, or
# payments succeed and Octos never hears:
#   https://<your-host>/api/v1/storefront/webhook/paystack/
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# mNotify, for SMS
# The sender ID must be one mNotify has approved for the account. An
# unapproved one is accepted and never delivered, which looks exactly
# like working.
#
# Empty on purpose: with no key the sender logs instead of sending, so
# a developer machine never texts a real customer.
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=Farhat

# Where the frontends live
# Comma-separated, no spaces. Both the storefront and the staff app
# need listing or the browser refuses every request.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180